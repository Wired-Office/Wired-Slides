{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wired Slides",
  "mainBinaryName": "wired-slides",
  "version": "1.0.0",
  "identifier": "com.wiredoffice.wiredslides",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wired Slides",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Presentations with a familiar PowerPoint workflow",
    "longDescription": "Wired Slides makes presentations with layouts, themes, shapes, pictures, tables, charts, SmartArt, transitions, animations and a full-screen slide show. Presentations are .wslides files that also open in Wired Slides for Mac, and it opens and saves PowerPoint (.pptx).",
    "publisher": "Wired Office",
    "copyright": "© Wired Office",
    "homepage": "https://github.com/999david7/Wired-Slides",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["wslides"],
        "name": "Wired Slides Presentation",
        "description": "Wired Slides Presentation",
        "mimeType": "application/vnd.wiredslides.wslides",
        "role": "Editor"
      },
      {
        "ext": ["pptx"],
        "name": "PowerPoint Presentation",
        "description": "PowerPoint Presentation",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
